# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "CAO paramétrique fonctionnelle en OCaml, orientée impression 3D et mécanismes"
maintainer: ["Marc de Falco"]
authors: ["Marc de Falco"]
homepage: "https://github.com/MarcdeFalco/camlcad"
bug-reports: "https://github.com/MarcdeFalco/camlcad/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.14"}
  "js_of_ocaml"
  "js_of_ocaml-compiler"
  "ppx_expect" {with-test}
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/MarcdeFalco/camlcad.git"
