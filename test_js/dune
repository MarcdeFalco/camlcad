; Tests du noyau manifold-3d sous Node. Prérequis : npm ci dans test_js/.
; Lancement : dune build @runtest-js (hors de dune test, qui reste pur OCaml).

(executables
 (names laws support examples mech skill)
 (modes js)
 (libraries geom cad cad_export cad_examples cad_mech kernel_suites kernel_manifold_js))

(rule
 (alias runtest-js)
 (deps run.mjs laws.bc.js (source_tree node_modules))
 (action
  (progn
   (with-stdout-to laws.output (run node run.mjs laws.bc.js))
   (diff laws.expected laws.output))))

(rule
 (alias runtest-js)
 (deps run.mjs support.bc.js (source_tree node_modules))
 (action
  (progn
   (with-stdout-to support.output (run node run.mjs support.bc.js))
   (diff support.expected support.output))))

(rule
 (alias runtest-js)
 (deps run.mjs examples.bc.js (source_tree node_modules))
 (action
  (progn
   (with-stdout-to examples.output (run node run.mjs examples.bc.js))
   (diff examples.expected examples.output))))

; Worker de l'éditeur web (toplevel complet : build long, ~40 Mo en profil dev).
(rule
 (alias runtest-js)
 (deps worker.mjs %{dep:../web/toplevel.bc.js} (glob_files ../examples/*.ml) (source_tree node_modules))
 (action
  (progn
   (with-stdout-to worker.output (run node worker.mjs ../web/toplevel.bc.js ../examples))
   (diff worker.expected worker.output))))

(rule
 (alias runtest-js)
 (deps run.mjs mech.bc.js (source_tree node_modules))
 (action
  (progn
   (with-stdout-to mech.output (run node run.mjs mech.bc.js))
   (diff mech.expected mech.output))))

(rule
 (alias runtest-js)
 (deps run.mjs skill.bc.js (source_tree node_modules))
 (action
  (progn
   (with-stdout-to skill.output (run node run.mjs skill.bc.js))
   (diff skill.expected skill.output))))

; Exemples de la skill chargés comme dans l'éditeur (même toplevel que worker.mjs).
(rule
 (alias runtest-js)
 (deps skill_worker.mjs %{dep:../web/toplevel.bc.js} (glob_files ../skills/camlcad/examples/*.ml) (source_tree node_modules))
 (action
  (progn
   (with-stdout-to skill_worker.output (run node skill_worker.mjs ../web/toplevel.bc.js ../skills/camlcad/examples))
   (diff skill_worker.expected skill_worker.output))))
